# Copier en .env.local pour le développement local avec l'Emulator Suite.
# Ne jamais committer de valeur réelle.

APP_ENV=local
APP_ORIGIN=http://localhost:3000
CONTENT_MIN_STATUS=draft
LAB_MIN_STATUS=draft
APP_CHECK_ENFORCED=false
SQL_SERVER_GRADING_ENABLED=false
NEXT_PUBLIC_PRODUCT_NAME=Orion Data Lab

# Émulateurs (projet de démonstration : aucun accès à un vrai projet)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-tuto-databricks
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-tuto-databricks.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
GCLOUD_PROJECT=demo-tuto-databricks
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Staging / production : NEXT_PUBLIC_FIREBASE_* sont fournis par App Hosting (FIREBASE_WEBAPP_CONFIG).
# NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
