rules_version = '2';

// Modèle d'accès (phase 1) :
// - toutes les écritures passent par les Route Handlers (Admin SDK, qui contourne ces règles) ;
// - un client authentifié ne peut lire que ses propres documents, dans une liste fermée de collections ;
// - tout le reste est refusé par défaut.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;

      match /lessonProgress/{progressId} {
        allow get, list: if isOwner(uid);
        allow write: if false;
      }

      match /trackProgress/{trackId} {
        allow get, list: if isOwner(uid);
        allow write: if false;
      }

      match /exerciseResults/{exerciseId} {
        allow get, list: if isOwner(uid);
        allow write: if false;
      }

      match /labProgress/{labId} {
        allow get, list: if isOwner(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
